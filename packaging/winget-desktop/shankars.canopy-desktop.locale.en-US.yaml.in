# Rendered by scripts/winget.sh --desktop from packaging/winget-desktop/. Edit the template.
PackageIdentifier: shankars.canopy-desktop
PackageVersion: @VERSION@
PackageLocale: en-US
Publisher: Sachin Shankar
PublisherUrl: https://github.com/shankar-sachin
PublisherSupportUrl: https://github.com/shankar-sachin/canopy/issues
Author: Sachin Shankar
PackageName: canopy (desktop)
PackageUrl: https://shankar-sachin.github.io/canopy/
License: MIT
LicenseUrl: https://github.com/shankar-sachin/canopy/blob/main/LICENSE
ShortDescription: Git, at a glance. A friendly desktop app for git and GitHub (release preview).
Description: |-
  Canopy Desktop is the place to start with git. It shows your whole repository in
  one window: what changed, what's staged, where your branch stands, and what to
  do next, with a button for each step. It explains every term in plain words,
  asks before anything destructive, and undoes the last commit, reset or checkout.
  Stage single lines with a click, browse the commit graph, and (with the GitHub
  CLI) work with pull requests, issues and Actions runs.
Moniker: canopy-desktop
Tags:
- git
- github
- desktop
- gui
- dashboard
ReleaseNotesUrl: https://github.com/shankar-sachin/canopy/releases/tag/v@VERSION@
Documentations:
- DocumentLabel: Wiki
  DocumentUrl: https://shankar-sachin.github.io/canopy/wiki/
ManifestType: defaultLocale
ManifestVersion: 1.9.0
