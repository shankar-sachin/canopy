# Generated by the release workflow in shankar-sachin/canopy from
# packaging/homebrew/canopy.rb.in. Edit the template, not this file.
#
# Installs the prebuilt binary from the GitHub release, so nothing is
# compiled (Homebrew on Linux needs no C compiler or Rust).
class Canopy < Formula
  desc "Beautiful, powerful git dashboard for your terminal"
  homepage "https://shankar-sachin.github.io/canopy/"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/shankar-sachin/canopy/releases/download/v@VERSION@/canopy-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/shankar-sachin/canopy/releases/download/v@VERSION@/canopy-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/shankar-sachin/canopy/releases/download/v@VERSION@/canopy-v@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/shankar-sachin/canopy/releases/download/v@VERSION@/canopy-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "canopy"
  end

  def caveats
    "Canopy needs git on your PATH (it runs your own git). GitHub pages also use the GitHub CLI (gh)."
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/canopy --version")
  end
end
