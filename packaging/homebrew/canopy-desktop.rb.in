# Generated by the release workflow in shankar-sachin/canopy from
# packaging/homebrew/canopy-desktop.rb.in. Edit the template, not this file.
cask "canopy-desktop" do
  arch arm: "aarch64", intel: "x86_64"

  version "@VERSION@"
  sha256 arm:   "@SHA_ARM@",
         intel: "@SHA_INTEL@"

  url "https://github.com/shankar-sachin/canopy/releases/download/v#{version}/canopy-desktop-v#{version}-#{arch}-apple-darwin.dmg"
  name "Canopy"
  desc "Beautiful, powerful git dashboard"
  homepage "https://shankar-sachin.github.io/canopy/"

  depends_on macos: ">= :catalina"

  app "Canopy.app"

  zap trash: "~/.config/canopy/desktop.json"

  caveats <<~EOS
    Canopy isn't notarized by Apple yet. If macOS says it can't be opened,
    open System Settings → Privacy & Security and click "Open Anyway", or run:
      xattr -dr com.apple.quarantine /Applications/Canopy.app
  EOS
end
