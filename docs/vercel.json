{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "cp ../scripts/install.sh ../scripts/install.ps1 ../scripts/install-desktop.sh ../scripts/install-desktop.ps1 .",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/install(.*)\\.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-shellscript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/install(.*)\\.ps1",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
